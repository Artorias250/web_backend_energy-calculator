{{> main title=title}}

<div class="feed-container">
    <div class="mobile-wrapper">
        <div class="draft-content">
            <h2 class="draft-title">Черновик прибора</h2>

            <form class="draft-form" onsubmit="event.preventDefault();">
                <!-- 1. Поле и предпросмотр ФОТО -->
                <div class="form-group">
                    <label>Фотография</label>
                    <input type="file" accept="image/*" class="form-file-input">
                    {{#if imageUrl}}
                        <div class="preview-box">
                            <img src="{{imageUrl}}" alt="Черновое фото" class="media-preview-large" />
                        </div>
                    {{/if}}
                </div>

                <!-- 2. Поле и предпросмотр ВИДЕО -->
                <div class="form-group">
                    <label>Видеозапись</label>
                    <input type="file" accept="video/*" class="form-file-input">
                    {{#if videoUrl}}
                        <div class="preview-box">
                            <video src="{{videoUrl}}" autoplay muted loop class="media-preview-large"></video>
                        </div>
                    {{/if}}
                </div>

                <!-- 3. Название устройства -->
                <div class="form-group">
                    <label>Название устройства</label>
                    <input type="text" value="{{appliance.deviceName}}" class="form-input" placeholder="Название">
                </div>

                <!-- 4. Единое поле описания -->
                <div class="form-group">
                    <label>Описание</label>
                    <textarea class="form-textarea" rows="2" placeholder="Описание">{{appliance.description}}</textarea>
                </div>

                <!-- 5. Мощность и минимальная температура -->
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label>Мощность (Вт)</label>
                        <input type="number" value="{{appliance.powerWatts}}" class="form-input" placeholder="Вт">
                    </div>

                    <div class="form-group flex-1">
                        <label>Мин. температура (°C)</label>
                        <input type="number" value="{{appliance.minTemperature}}" class="form-input" placeholder="°C">
                    </div>
                </div>

                <button type="button" class="btn-add-disabled" disabled>
                    Добавить прибор
                </button>
            </form>
        </div>

        <div class="catalog-bottom-sheet">
            {{> navigation}}
        </div>
    </div>
</div>
