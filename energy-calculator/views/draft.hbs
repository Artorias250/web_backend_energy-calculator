{{> main title=title}}

<div class="feed-container">
    <div class="mobile-wrapper">
        <div class="draft-content">
            <h2 class="draft-title">Черновик прибора</h2>

            <form class="draft-form" onsubmit="event.preventDefault();">
                <div class="form-group">
                    <label>Название устройства</label>
                    <input type="text" value="{{draft.deviceName}}" class="form-input" placeholder="Название">
                </div>

                <div class="form-group">
                    <label>Краткое описание</label>
                    <input type="text" value="{{draft.description}}" class="form-input" placeholder="Краткое описание">
                </div>

                <div class="form-group">
                    <label>Полное описание</label>
                    <textarea class="form-textarea" rows="2" placeholder="Полное описание">{{draft.fullDescription}}</textarea>
                </div>

                <div class="form-row">
                    <div class="form-group flex-1">
                        <label>Мощность (Вт)</label>
                        <input type="number" value="{{draft.powerWatts}}" class="form-input" placeholder="Вт">
                    </div>

                    <div class="form-group flex-1">
                        <label>Категория</label>
                        <input type="text" value="{{draft.category}}" class="form-input" placeholder="Категория">
                    </div>
                </div>

                <!-- Поля для загрузки медиа -->
                <div class="form-row">
                    <div class="form-group flex-1">
                        <label>Фотография</label>
                        <input type="file" accept="image/*" class="form-file-input">
                    </div>

                    <div class="form-group flex-1">
                        <label>Видеозапись</label>
                        <input type="file" accept="video/*" class="form-file-input">
                    </div>
                </div>

                {{#if draft.videoUrl}}
                    <div class="form-group">
                        <label>Предпросмотр видео</label>
                        <video src="{{draft.videoUrl}}" controls class="media-preview"></video>
                    </div>
                {{/if}}

                <button type="button" class="btn-add-disabled" disabled>
                    Добавить прибор
                </button>
            </form>
        </div>

        <div class="catalog-bottom-sheet">
            {{> navigation}}
        </div>
    </div>
</div>
